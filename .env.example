# Bara för att köra agenten på din egen dator. I GitHub läggs samma värden
# in som hemligheter (Settings -> Secrets and variables -> Actions).
# Kopiera filen till .env och fyll i. Dela aldrig .env med någon.

# Från platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# Från Meta for Developers -> din app -> Instagram -> API setup with Instagram business login -> Generate token
IG_ACCESS_TOKEN=

# Valfritt. Hämtas automatiskt från token om det lämnas tomt.
IG_USER_ID=

# Valfritt. Användarnamnet som står längst ned på bilden. Hämtas från Instagram om tomt.
IG_HANDLE=

# Valfritt. Tidszon för vilket datum som är "i dag".
TIDSZON=Europe/Stockholm

# Valfritt. Vilken Claude-modell som används.
CLAUDE_MODEL=claude-sonnet-5-5

# Valfritt. Instagram API-version.
IG_API_VERSION=v25.0

# Sätts automatiskt i GitHub Actions. Behövs bara om du publicerar WOD från datorn.
BILD_BAS_URL=
